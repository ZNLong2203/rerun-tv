# Copy to .env.local (gitignored) and fill in. Nothing here is required to run
# the demo: the prepared tracks in content/ already include the AI output.

# Claude, for `npm run enrich` (preparing a new title) and live questions.
# Alternatively run `ant auth login` and leave this empty.
ANTHROPIC_API_KEY=

# Model overrides (defaults: claude-opus-5-5).
RERUN_MODEL=
RERUN_ASK_MODEL=

# Server
PORT=8787
# Public HTTPS base URL for the phone QR code (e.g. a tunnel). Phones need
# HTTPS for the microphone; without it the LAN address is used.
PUBLIC_URL=
# Set to "false" to start without the demo household.
SEED_DEMO=
