# Copy to .env.local (gitignored) and fill in. Nothing here is required to run
# the demo: the prepared tracks in content/ already include the AI output.

# Gemini, for `npm run enrich` (preparing a new title) and live questions.
GEMINI_API_KEY=

# Optional: use Claude instead (ANTHROPIC_API_KEY or `ant auth login`).
ANTHROPIC_API_KEY=
# "gemini" or "claude"; empty picks whichever key is set, Gemini first.
RERUN_PROVIDER=

# Model overrides. Defaults: gemini-3.8-flash / claude-opus-5-5.
RERUN_MODEL=
RERUN_ASK_MODEL=

# Server
PORT=8787
# Public HTTPS base URL for the phone QR code and video (e.g. a tunnel). Phones
# need HTTPS for the microphone and Vega needs HTTPS for video.
PUBLIC_URL=
# Set to "false" to start without the demo household.
SEED_DEMO=
# Set to "off" to disable live questions even when a key is set.
RERUN_ASK=
